# ============================================================================
# CONFIGURAÇÃO DO FRONTEND - AMBIENTES
# ============================================================================

# Crie dois arquivos para separar DESENVOLVIMENTO de PRODUÇÃO:
#
# ✅ .env.local (DESENVOLVIMENTO - não versionar)
#    VITE_API_URL=http://localhost:3001/api
#
# ✅ .env.production (PRODUÇÃO - não versionar)
#   VITE_API_URL=https://meu-backend-em-producao.com/api
# O Vite carrega automaticamente baseado em:
# - npm run dev  → usa .env.local
# - npm run build → usa .env.production

# Padrão para referência (opcional):
VITE_API_URL=http://localhost:3001/api
