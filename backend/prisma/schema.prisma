// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USUÁRIOS
// ============================================================================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação: um usuário tem muitos cursos
  courses                Course[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscription String?

  @@map("users")
}

// ============================================================================
// CURSOS
// ============================================================================
model Course {
  id         Int      @id @default(autoincrement())
  name       String
  university String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Chave estrangeira: qual usuário criou este curso
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relação: um curso tem muitas matérias
  subjects                 Subject[]
  notifications            Notification[]
  notificationPreference   NotificationPreference? @relation(fields: [notificationPreferenceId], references: [id])
  notificationPreferenceId Int?

  @@map("courses")
}

// ============================================================================
// MATÉRIAS
// ============================================================================
model Subject {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  period      String?       // Período da matéria no currículo (ex: "1º período", "2º período")
  type        SubjectType   @default(OBRIGATORIA)
  status      SubjectStatus @default(PENDENTE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Chave estrangeira: a qual curso pertence esta matéria
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Relações
  professorSubjects ProfessorSubject[]
  statusHistory     SubjectStatusHistory[]

  @@map("subjects")
}

// Histórico de mudanças de status de uma matéria
model SubjectStatusHistory {
  id        Int           @id @default(autoincrement())
  subjectId Int
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  status    SubjectStatus
  semester  String?       // "2026/1"
  note      String?       // motivo da mudança
  createdAt DateTime      @default(now())

  @@map("subject_status_history")
}

// ============================================================================
// PROFESSORES
// ============================================================================
model Professor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação: um professor leciona muitas matérias
  subjects ProfessorSubject[]

  @@map("professors")
}

// ============================================================================
// PROFESSOR-SUBJECT (Junction Table)
// ============================================================================
model ProfessorSubject {
  id        Int      @id @default(autoincrement())
  semestre  String // Semestre que o professor lecionou (ex: "2025/1", "2026/2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chaves estrangeiras
  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Relações: muitas tarefas, rotinas e arquivos
  tasks    Task[]
  routines Routine[]
  files    File[]

  // Garante que não há duplicatas (mesmo professor não pode lecionar a mesma matéria no mesmo semestre duas vezes)
  @@unique([professorId, subjectId, semestre])
  @@map("professor_subjects")
}

// ============================================================================
// TAREFAS (Atividades, Trabalhos, Provas)
// ============================================================================
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  type        TaskType  @default(ATIVIDADE)
  completed   Boolean   @default(false)
  weight      Float     @default(1.0) // peso da tarefa
  dueDate     DateTime?
  priority    Priority  @default(MEDIA)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Chave estrangeira: a qual professor-matéria pertence
  professorSubjectId Int
  professorSubject   ProfessorSubject @relation(fields: [professorSubjectId], references: [id], onDelete: Cascade)

  evaluation    Evaluation?
  notifications Notification[]
  notifiedAt DateTime? // Quando foi notificado pela última vez

  @@map("tasks")
}

// ============================================================================
// ENUMS
// ============================================================================

// Tipos de matérias
enum SubjectType {
  OBRIGATORIA
  ELETIVA
  OPTATIVA
  FACULTATIVA
  EXTENSAO
}

// Status da matéria no histórico acadêmico do aluno
enum SubjectStatus {
  PENDENTE    // ainda não cursou
  ATIVA       // matriculado neste semestre
  APROVADA    // concluída com sucesso
  REPROVADA   // cursou e reprovou
  TRANCADA    // matrícula trancada
  DISPENSADA  // aproveitamento de estudos
}

// Tipos de tarefas
enum TaskType {
  ATIVIDADE
  TRABALHO
  PROVA
}

// Prioridade
enum Priority {
  BAIXA
  MEDIA
  ALTA
}

// ============================================================================
// ROTINAS (Agendas de Estudo)
// ============================================================================
model Routine {
  id        Int       @id @default(autoincrement())
  dayOfWeek DayOfWeek
  startTime String // "14:30"
  duration  Int // em minutos (ex: 90)
  activity  String // "Revisar slides"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Chave estrangeira: em qual professor-matéria estudar
  professorSubjectId Int
  professorSubject   ProfessorSubject @relation(fields: [professorSubjectId], references: [id], onDelete: Cascade)

  @@map("routines")
}

// Dias da semana
enum DayOfWeek {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Evaluation {
  id     Int  @id @default(autoincrement())
  taskId Int  @unique
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  grade    Float // Nota obtida (ex: 8.5)
  maxGrade Float @default(10) // Nota máxima (ex: 10)
  weight   Float @default(1.0) // Peso da avaliação (ex: 30%)

  evaluatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("evaluations")
}

// ============================================================================
// ARQUIVOS
// ============================================================================
model File {
  id           Int     @id @default(autoincrement())
  name         String?        // Nome exibido do arquivo
  url          String         // URL do Cloudinary
  mimeType     String?
  size         Int?           // Tamanho em bytes
  cloudinaryId String?        // ID no Cloudinary (para deletar)

  professorSubjectId Int
  professorSubject   ProfessorSubject @relation(fields: [professorSubjectId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("files")
}

// ============================================================================
// NOTIFICAÇÕES
// ============================================================================

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId Int? // ← IMPORTANTE
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title String
  body  String
  read  Boolean @default(false)
  readAt    DateTime?

  // ← NOVO: Tipo de notificação
  type String @default("task_due_soon") // task_due_soon, task_created, etc

  createdAt DateTime @default(now())
  course    Course?  @relation(fields: [courseId], references: [id])
  courseId  Int?

  @@index([userId])
  @@index([taskId])
}

model NotificationPreference {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  inAppNotifications Boolean @default(true)

  // Em quantos dias antes notificar?
  notifyDaysBefore Int @default(2)

  // Em quantas horas antes notificar? (ex: 1 hora antes do vencimento)
  notifyHoursBefore Int @default(1)

  // Só notificar em certos horários?
  quietHoursStart Int? // 23 = 23h
  quietHoursEnd   Int? // 8 = 8h

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]
}
